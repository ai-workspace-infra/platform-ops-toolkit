{
  "version": 2,
  "repositories": [
    {
      "repository": "ai-workspace-infra/platform-ops-toolkit",
      "workflow": null,
      "trigger": "none",
      "environments": ["sit", "uat", "prod"],
      "artifacts": ["workflow"]
    },
    {
      "repository": "ai-workspace-services/accounts",
      "workflow": "ci-pipeline.yml",
      "trigger": "push",
      "dispatch_inputs": {"deploy_env": "${DEPLOY_ENV}"},
      "artifacts": ["image", "binary", "zip", "release-manifest"]
    },
    {
      "repository": "ai-workspace-services/billing-service",
      "workflow": "ci-pipeline.yml",
      "trigger": "push",
      "dispatch_inputs": {"deployment_environment": "${DEPLOY_ENV}"},
      "artifacts": ["image", "binary", "zip", "release-manifest"]
    },
    {
      "repository": "ai-workspace-services/content-service",
      "workflow": "ci-pipeline.yml",
      "trigger": "push",
      "dispatch_inputs": {"deployment_environment": "${DEPLOY_ENV}"},
      "artifacts": ["image", "binary", "zip", "release-manifest"]
    },
    {
      "repository": "ai-workspace-services/portal",
      "workflow": "ci-pipeline.yml",
      "trigger": "push",
      "dispatch_inputs": {"deployment_environment": "${DEPLOY_ENV}"},
      "artifacts": ["image", "release-manifest"]
    },
    {
      "repository": "ai-workspace-services/edge-gateway",
      "workflow": "deploy.yml",
      "trigger": "push",
      "dispatch_inputs": {},
      "artifacts": []
    },
    {
      "repository": "ai-workspace-lab/xworkmate-bridge",
      "workflow": "pipeline.yml",
      "trigger": "workflow_dispatch",
      "dispatch_inputs": {
        "environment": "${DEPLOY_ENV}",
        "run_apply": "false"
      },
      "artifacts": ["image", "binary"]
    },
    {
      "repository": "ai-workspace-services/postgresql.svc.plus",
      "workflow": "ci-pipeline.yml",
      "trigger": "push",
      "dispatch_inputs": {
        "image_tag": "${SNAPSHOT_TAG}",
        "deployment_environment": "${DEPLOY_ENV}",
        "push_latest": "false"
      },
      "artifacts": ["image", "chart", "release-manifest"]
    },
    {
      "repository": "ai-workspace-xstream/xray-exporter",
      "workflow": "build-release-deploy.yml",
      "trigger": "push",
      "environments": ["sit", "uat"],
      "artifacts": ["release-assets", "xray-exporter-linux-amd64"]
    }
  ]
}
