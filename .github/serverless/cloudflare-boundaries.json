{
  "version": 1,
  "environment": "uat",
  "hosts": {
    "console": "console-cloudflare-uat.onwalk.net",
    "accounts": "accounts-cloudflare-uat.onwalk.net"
  },
  "boundaries": [
    {
      "id": "ssr-public",
      "kind": "worker",
      "name": "frontend-ssr-public-uat",
      "source": "ai-workspace-services/portal",
      "host": "console",
      "routes": ["/*", "/_edge/public/*"]
    },
    {
      "id": "ssr-content",
      "kind": "worker",
      "name": "frontend-ssr-content-uat",
      "source": "ai-workspace-services/portal",
      "host": "console",
      "routes": ["/blogs*", "/docs*", "/download*", "/_edge/content/*"]
    },
    {
      "id": "ssr-auth",
      "kind": "worker",
      "name": "frontend-ssr-auth-uat",
      "source": "ai-workspace-services/portal",
      "host": "console",
      "routes": ["/login*", "/register*", "/email-verification*", "/logout*", "/_edge/auth/*"]
    },
    {
      "id": "ssr-console",
      "kind": "worker",
      "name": "frontend-ssr-console-uat",
      "source": "ai-workspace-services/portal",
      "host": "console",
      "routes": ["/panel*", "/dashboard*", "/_edge/console/*"]
    },
    {
      "id": "ssr-workspace",
      "kind": "worker",
      "name": "frontend-ssr-workspace-uat",
      "source": "ai-workspace-services/portal",
      "host": "console",
      "routes": ["/ai-workspace*", "/cloud_iac*", "/editor*", "/support*", "/xworkmate*", "/_edge/workspace/*"]
    },
    {
      "id": "api-auth",
      "kind": "worker",
      "name": "edge-gateway-auth-uat",
      "source": "ai-workspace-services/edge-gateway",
      "host": "accounts",
      "routes": ["/api/auth/*"]
    },
    {
      "id": "api-admin",
      "kind": "worker",
      "name": "edge-gateway-admin-uat",
      "source": "ai-workspace-services/edge-gateway",
      "host": "accounts",
      "routes": ["/api/admin/*"]
    },
    {
      "id": "api-core",
      "kind": "worker",
      "name": "edge-gateway-core-uat",
      "source": "ai-workspace-services/edge-gateway",
      "host": "accounts",
      "routes": ["/api/*"]
    },
    {
      "id": "static",
      "kind": "pages",
      "name": "ai-workspace-portal-uat",
      "source": "ai-workspace-services/portal",
      "host": "console",
      "routes": ["/static/*", "/assets/*"]
    }
  ]
}
