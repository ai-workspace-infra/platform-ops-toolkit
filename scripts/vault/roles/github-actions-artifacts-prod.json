{
  "role_name": "github-actions-artifacts-prod",
  "description": "Artifacts PROD consumer; workflow-bound artifact credential access.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": [
    "vault"
  ],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/artifacts",
    "job_workflow_ref": "ai-workspace-infra/artifacts/.github/workflows/*@*",
    "ref": [
      "refs/tags/v*",
      "refs/heads/release/v*"
    ]
  },
  "token_policies": [
    "github-actions-artifacts"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "1h",
  "token_max_ttl": "1h"
}
