{
  "role_name": "github-actions-platform-ops-toolkit-shared-gcp-oidc-open-platform-prod",
  "description": "Runtime GCP OIDC role for the shared Vault stack in open-platform-prod; only the protected prod GitHub Environment and reusable GCP IAC workflow may assume it.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": ["vault"],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/platform-ops-toolkit",
    "environment": "prod",
    "job_workflow_ref": "ai-workspace-infra/platform-ops-toolkit/.github/workflows/gcp-iac-pipeline.yml@*",
    "ref": "refs/heads/main"
  },
  "token_policies": [
    "github-actions-platform-ops-toolkit-shared-gcp-oidc-open-platform-prod"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "20m",
  "token_max_ttl": "20m"
}
