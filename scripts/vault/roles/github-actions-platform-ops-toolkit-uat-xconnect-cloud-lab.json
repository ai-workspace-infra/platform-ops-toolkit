{
  "role_name": "github-actions-platform-ops-toolkit-uat-xconnect-cloud-lab",
  "description": "Dedicated disposable XConnect cloud-lab UAT role; reads only the relay and lab records.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": [
    "vault"
  ],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/platform-ops-toolkit",
    "job_workflow_ref": "ai-workspace-infra/platform-ops-toolkit/.github/workflows/xconnect-zero-cloud.yaml@refs/heads/main",
    "ref": "refs/heads/main"
  },
  "token_policies": [
    "github-actions-platform-ops-toolkit-uat-xconnect-cloud-lab"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "1h",
  "token_max_ttl": "1h"
}
