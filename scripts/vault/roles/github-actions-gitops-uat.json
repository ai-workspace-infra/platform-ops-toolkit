{
  "role_name": "github-actions-gitops-uat",
  "description": "GitOps UAT deployment consumer; validate-release-pr workflow only.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": [
    "vault"
  ],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/gitops",
    "job_workflow_ref": "ai-workspace-infra/gitops/.github/workflows/validate-release-pr.yml@*",
    "ref": "refs/heads/main"
  },
  "token_policies": [
    "github-actions-gitops"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "1h",
  "token_max_ttl": "1h"
}
