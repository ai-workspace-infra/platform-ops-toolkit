{
  "role_name": "github-actions-accounts-sit",
  "description": "accounts SIT business CI; shared CICD credential read access only.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": [
    "vault"
  ],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-services/accounts",
    "job_workflow_ref": "ai-workspace-services/accounts/.github/workflows/*pipeline.ym*@*",
    "ref": [
      "refs/pull/*/merge",
      "refs/heads/*",
      "refs/tags/sit-*"
    ]
  },
  "token_policies": [
    "github-actions-accounts"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "1h",
  "token_max_ttl": "1h"
}
