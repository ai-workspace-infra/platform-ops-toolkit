{
  "role_name": "github-actions-platform-ops-toolkit-tls-rotation",
  "description": "Scheduled TLS certificate rotation role on protected main.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": [
    "vault"
  ],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/platform-ops-toolkit",
    "job_workflow_ref": "ai-workspace-infra/platform-ops-toolkit/.github/workflows/cron-rotate-domain-tls-certs.yaml@*",
    "ref": "refs/heads/main"
  },
  "token_policies": [
    "github-actions-platform-ops-toolkit-tls-rotation"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "1h",
  "token_max_ttl": "1h"
}
