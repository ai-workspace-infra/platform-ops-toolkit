{
  "role_name": "github-actions-platform-ops-toolkit-prod-akamai-oidc-bootstrap-primary",
  "description": "Akamai Cloud/Linode production IaC role: only the protected release workflow may read the primary provider token and production S3-compatible state parameters.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": ["vault"],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/platform-ops-toolkit",
    "job_workflow_ref": "ai-workspace-infra/platform-ops-toolkit/.github/workflows/akamai-cloud-iac.yml@*",
    "ref": ["refs/tags/v*", "refs/heads/release/v*"],
    "environment": "prod"
  },
  "token_policies": ["github-actions-platform-ops-toolkit-prod-akamai-oidc-bootstrap-primary"],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "20m",
  "token_max_ttl": "20m"
}
