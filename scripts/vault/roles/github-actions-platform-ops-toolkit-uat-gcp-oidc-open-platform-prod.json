{
  "role_name": "github-actions-platform-ops-toolkit-uat-gcp-oidc-open-platform-prod",
  "description": "UAT runtime GCP OIDC role for the open-platform-prod project; reads the shared platform identity record and UAT state credentials.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": [
    "vault"
  ],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/platform-ops-toolkit",
    "job_workflow_ref": [
      "ai-workspace-infra/platform-ops-toolkit/.github/workflows/iac-pipeline-multi-cloud-landingzone-baseline.yaml@*",
      "ai-workspace-infra/platform-ops-toolkit/.github/workflows/iac-pipeline-multi-cloud-account-matrix.yaml@*",
      "ai-workspace-infra/platform-ops-toolkit/.github/workflows/iac-pipeline-multi-cloud-resources-matrix.yaml@*",
      "ai-workspace-infra/platform-ops-toolkit/.github/workflows/gcp-iac-pipeline.yml@*",
      "ai-workspace-infra/platform-ops-toolkit/.github/workflows/selfhost-orchestrator.yml@*",
      "ai-workspace-infra/platform-ops-toolkit/.github/workflows/iac-pipeline-multi-cloud-stages.yaml@refs/heads/main"
    ],
    "ref": [
      "refs/heads/main",
      "refs/tags/uat-*"
    ]
  },
  "token_policies": [
    "github-actions-platform-ops-toolkit-uat-gcp-oidc-open-platform-prod"
  ],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "20m",
  "token_max_ttl": "20m"
}
