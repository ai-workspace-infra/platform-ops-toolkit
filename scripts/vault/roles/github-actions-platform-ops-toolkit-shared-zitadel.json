{
  "role_name": "github-actions-platform-ops-toolkit-shared-zitadel",
  "description": "Shared IAM service delivery: GCP identity and IAM/database secrets, scoped to zitadel-server on main.",
  "role_type": "jwt",
  "user_claim": "sub",
  "bound_audiences": ["vault"],
  "bound_claims_type": "glob",
  "bound_claims": {
    "repository": "ai-workspace-infra/platform-ops-toolkit",
    "environment": "prod",
    "job_workflow_ref": "ai-workspace-infra/platform-ops-toolkit/.github/workflows/zitadel-server.yml@refs/heads/main",
    "ref": "refs/heads/main"
  },
  "token_policies": ["github-actions-platform-ops-toolkit-shared-zitadel"],
  "token_no_default_policy": true,
  "token_type": "batch",
  "token_ttl": "20m",
  "token_max_ttl": "20m"
}
